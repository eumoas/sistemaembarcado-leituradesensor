{
  "name": "ESP-IDF 5.5",
  "image": "espressif/idf:v5.5",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/esp-projects,type=bind",
  "workspaceFolder": "/workspaces/esp-projects",
  "customizations": {
    "vscode": {
      "extensions": ["espressif.esp-idf-extension"],
      "settings": {
        "idf.extensionActivationMode": "always",
        "idf.customExtraVars": {
          "IDF_PATH": "/opt/esp/idf",
          "IDF_TOOLS_PATH": "/opt/esp",
          "IDF_PYTHON_ENV_PATH": "/opt/esp/python_env/idf5.5_py3.12_env"
        },
        "terminal.integrated.profiles.linux": {
          "ESP-IDF": {
            "path": "/bin/bash",
            "args": ["--init-file", "/opt/esp/idf/export.sh"]
          }
        },
        "terminal.integrated.defaultProfile.linux": "ESP-IDF"
      }
    }
  }
}
